# Copy to .env.local and fill in.

# MongoDB connection string (local or MongoDB Atlas).
MONGODB_URI=mongodb+srv://XXXXXXXX:XXXXXXXXXXX@cluster0.7aakgmm.mongodb.net/?appName=Cluster0

# Auth.js secret. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Opens sign-up at /registo and points the landing page to it. Keep it off until
# payments, /termos and /privacidade exist. Needs a redeploy to change.
REGISTRATION_OPEN=false

# Email (confirmation and password recovery), https://resend.com
# Without a key, development prints emails to the terminal.
RESEND_API_KEY=
MAIL_FROM=Nailo App <ola@o-seu-dominio.pt>

# Stripe. Webhook endpoint: <SITE_URL>/api/stripe/webhook, with the events
# customer.subscription.created, .updated and .deleted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The two prices, created in the Stripe dashboard. Their amounts must match lib/plans.ts.
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_YEARLY=

# Optional
# Public URL of the platform, used for social-share previews.
SITE_URL=https://nailslux.vercel.app
# Where "Quero para o meu studio" goes on the landing page, e.g. a wa.me link.
PLATFORM_CONTACT_URL=
